{
  "name": "arma-reforger-launcher",
  "version": "0.3.43",
  "description": "Cross-platform preset and mod launcher for Arma Reforger",
  "main": "src/main/main.js",
  "private": true,
  "author": "ALGZ / ExtaZzZ",
  "license": "GPL-3.0-only",
  "algzUpdatePolicy": {
    "mode": "optional",
    "gracePeriodSeconds": 0
  },
  "homepage": "https://github.com/Redwolf29195/arma-reforger-launcher",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "node scripts/prepare-build.js && electron-builder --dir",
    "dist:win": "node scripts/prepare-build.js && electron-builder --win portable nsis",
    "dist:win:public": "node scripts/prepare-build.js --public && electron-builder --config electron-builder.release.cjs --win portable nsis",
    "dist:win:public-unsigned": "node scripts/prepare-build.js --public-unsigned && electron-builder --win portable nsis --config.directories.output=dist-public-unsigned/${version} && node scripts/sign-release-artifacts.js --root dist-public-unsigned",
    "release:win:public-unsigned": "node scripts/release-public-unsigned.js",
    "release:audit:public-unsigned": "node scripts/release-public-unsigned.js --reuse-build",
    "dist:linux": "node scripts/prepare-build.js && electron-builder --linux AppImage",
    "dist:mac": "node scripts/prepare-build.js && electron-builder --mac dmg",
    "build:prepare": "node scripts/prepare-build.js",
    "release:sign:artifacts": "node scripts/sign-release-artifacts.js"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.armareforger.launcher",
    "productName": "Arma Reforger Launcher",
    "copyright": "Copyright © 2026 ALGZ / ExtaZzZ and contributors. Licensed under GPL-3.0-only.",
    "asar": true,
    "afterPack": "./scripts/afterPack.cjs",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "directories": {
      "app": ".build/app",
      "output": "dist-local/${version}"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": ".build/app/launcher-addons/ALGZLauncherWorkshopBridge",
        "to": "launcher-addons/ALGZLauncherWorkshopBridge"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": ".build/app/src/renderer/assets/app-icon.png",
      "legalTrademarks": "ALGZ",
      "verifyUpdateCodeSignature": true
    },
    "portable": {
      "artifactName": "Arma-Reforger-Launcher-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Arma-Reforger-Launcher-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": ".build/app/src/renderer/assets/app-icon.png",
      "artifactName": "Arma-Reforger-Launcher-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": ".build/app/src/renderer/assets/app-icon.png",
      "artifactName": "Arma-Reforger-Launcher-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Redwolf29195/arma-reforger-launcher-updates/releases/latest/download/"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Redwolf29195/arma-reforger-launcher.git"
  }
}
